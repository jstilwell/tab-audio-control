*.pem
key.pem
*.key
!store/crx-public-key.pem

# Environment & secrets
.env
.env.*
!.env.example
*.local
.npmrc
.secrets/

# Generated during tests and scripts
test-results/
playwright-report/
blob-report/
playwright/.cache/
tests/e2e/.build/
scripts/.build/
coverage/
.vite/
.eslintcache
*.tsbuildinfo

# Logs
*.log
npm-debug.log*
logs/

# Editors & OS
.vscode/*
!.vscode/extensions.json
.idea/
*.swp
*~
.DS_Store
Thumbs.db
Desktop.ini

# AI assistant local state
.claude/
