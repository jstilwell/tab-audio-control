{
	"name": "tab-audio-control",
	"private": true,
	"version": "0.1.0",
	"description": "Per-tab volume, boost, EQ and voice focus for Chrome without breaking full screen.",
	"license": "MIT",
	"author": "Jesse Stilwell",
	"homepage": "https://github.com/jstilwell/tab-audio-control#readme",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/jstilwell/tab-audio-control.git"
	},
	"bugs": {
		"url": "https://github.com/jstilwell/tab-audio-control/issues"
	},
	"type": "module",
	"engines": {
		"node": ">=22"
	},
	"scripts": {
		"dev": "node scripts/build.mjs --watch",
		"build": "node scripts/build.mjs",
		"check": "svelte-check --tsconfig ./tsconfig.json",
		"format": "prettier --write .",
		"lint": "prettier --check . && eslint .",
		"test": "vitest run",
		"verify": "npm run check && npm run lint && npm run test && npm run test:e2e",
		"icons": "node scripts/icons.mjs",
		"package": "npm run verify && node scripts/package.mjs",
		"test:e2e": "npm run build && playwright test",
		"store-assets": "npm run build && node scripts/store-assets.mjs"
	},
	"devDependencies": {
		"@eslint/compat": "^2.1.1",
		"@eslint/js": "^10.0.1",
		"@playwright/test": "^1.64.1",
		"@sveltejs/vite-plugin-svelte": "^7.3.1",
		"@types/chrome": "^0.3.7",
		"@types/node": "^26",
		"eslint": "^10.13.0",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.23.1",
		"globals": "^17.13.0",
		"prettier": "^3.9.10",
		"prettier-plugin-svelte": "^4.1.1",
		"svelte": "^5.57.2",
		"svelte-check": "^4.7.7",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.72.0",
		"vite": "^8.3.5",
		"vitest": "^5.0.5"
	},
	"allowScripts": {
		"fsevents@2.3.3": true
	}
}
